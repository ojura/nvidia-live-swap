[Unit]
Description=Check the loaded NVIDIA driver and load nvpcf_hook for it
# The loader downloads NVIDIA's source archive when the archive for a new
# driver version is not in /var/cache/nvpcf-hook yet.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nvpcf-hook/load-hook.sh
RemainAfterExit=yes
# A oneshot unit has no start timeout by default, and multi-user.target waits
# for this one, so a loader that hangs would hold back multi-user.target and
# graphical.target, and every unit ordered after them, for good. The loader's
# longest run is a download, which curl ends after 600 seconds.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
